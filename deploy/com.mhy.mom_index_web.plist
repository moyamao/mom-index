<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mhy.mom_index_web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/mhy/python/mom-index/.venv/bin/python</string>
    <string>-u</string>
    <string>/Users/mhy/python/mom-index/scripts/web_server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/mhy/python/mom-index</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/mhy/python/mom-index/logs/web_server_launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mhy/python/mom-index/logs/web_server_launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
